{
  "name": "hitokuchi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "wrangler types --strict-vars=false --env-file .dev.vars.example && react-router typegen && tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply hitokuchi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hitokuchi-db --remote",
    "demo:add:local": "sh db/demo/add-local.sh",
    "demo:remove:local": "wrangler d1 execute hitokuchi-db --local --file=db/demo/remove.sql",
    "preview:only": "vite preview --port 4173 --strictPort",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node scripts/ci-gate.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "lock:check": "npx -y npm@10.9.2 ci --dry-run --ignore-scripts",
    "lock:refresh": "rm -rf node_modules package-lock.json && npm install && npm run lock:check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@react-router/dev": "^7.18.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  }
}
